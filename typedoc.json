{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["index.ts"],
  "tsconfig": "tsconfig.build.json",
  "plugin": ["typedoc-plugin-markdown"],
  "out": "docs/api",
  "readme": "none",
  "githubPages": false,
  "cleanOutputDir": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "validation": {
    "notExported": false
  },
  "disableSources": true,
  "hideGenerator": true,
  "skipErrorChecking": true
}
